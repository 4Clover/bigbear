# =============================================================================
# Grizzly — Environment Variables
# Copy to .env.local and fill in values
# =============================================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/grizzly?schema=public"

# Auth (NextAuth v5)
AUTH_SECRET="generate-with-openssl-rand-base64-33"
AUTH_URL="http://localhost:3000"

# Email (Resend)
AUTH_RESEND_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# -----------------------------------------------------------------------------
# Optional — Google OAuth (if set, both Google vars must be set)
# Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID → Redirect URIs:
#   https://your-domain.com/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
# Note: OAuth consent screen must be set to Production (not Testing)
# -----------------------------------------------------------------------------
# AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
# AUTH_GOOGLE_SECRET="your-google-client-secret"

# -----------------------------------------------------------------------------
# Optional — Admin auto-promotion (comma-separated emails → OWNER role on first sign-in)
# -----------------------------------------------------------------------------
# AUTHORIZED_ADMIN_EMAILS="admin@example.com,owner@example.com"

# Owner
OWNER_EMAIL="owner@yourdomain.com"

# Stripe
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Security tokens (must be different, min 16 chars each)
ICAL_SECRET="generate-random-string-min-16"
CRON_SECRET="generate-different-string-min-16"

# -----------------------------------------------------------------------------
# Optional — SMS (all three required if any is set)
# -----------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_PHONE_NUMBER="+15551234567"

# -----------------------------------------------------------------------------
# Optional — Rate limiting (falls back to in-memory in dev)
# -----------------------------------------------------------------------------
# UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="xxxxxxxxxx"

# -----------------------------------------------------------------------------
# Optional — File uploads (Vercel Blob)
# -----------------------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN="vercel_blob_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# -----------------------------------------------------------------------------
# Optional — Public app URL (used for Stripe redirects, email links)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
